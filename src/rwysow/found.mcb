import ../config.js
import ./crops.js

# At the corner of a mature crop block. A click harvests it. Tracking puts one marker over it, 0.03125 bigger than the block
# outline on every side so the client picks the marker before the crop. The marker response makes the client treat the click
# as handled, and the click fires player_interacted_with_entity.
REPEAT (cropNames) as name {
    function <%name%> {
        scoreboard players set #left rwysow 0
        execute if score #mode rwysow matches 1 run return run function rwysow:harvest/<%name%>
        execute positioned ~0.5 ~-<%markerMargin%> ~0.5 unless entity @e[type=minecraft:interaction,tag=rwysow.marker,distance=..0.3] run summon minecraft:interaction ~ ~ ~ {width:<%markerWidth%>f,height:<%markerHeight[name]%>f,response:true,Tags:["rwysow.marker"]}
        execute if score #config.show_outline rwysow matches 1 positioned ~0.5 ~-<%markerMargin%> ~0.5 unless entity @e[type=minecraft:block_display,tag=rwysow.outline,distance=..0.01] run function rwysow:outline/<%name%>
        execute positioned ~0.5 ~ ~0.5 run scoreboard players set @e[type=minecraft:interaction,tag=rwysow.marker,distance=..0.3] rwysow <%config.markerTicks%>
    }
}
