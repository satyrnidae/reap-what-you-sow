import ../config.js
import ./crops.js

# Blocks the ray passes through, so a marker is found behind immature crops. Mature crops are matched in step first.
tag blocks ray_pass {
    #minecraft:replaceable
    #minecraft:crops
    minecraft:nether_wart
}

# As and at a player holding a hoe. Track places markers, harvest is the click: it walks the same ray and harvests the
# first mature crop instead.
function track {
    scoreboard players set #mode rwysow 0
    function rwysow:ray/start
}

function harvest {
    scoreboard players set #mode rwysow 1
    function rwysow:ray/start
}

# Reach is the entity interaction range, 3 blocks, in rayStepCount steps of rayStep
function start {
    scoreboard players set #left rwysow <%config.rayStepCount%>
    execute anchored eyes positioned ^ ^ ^ run function rwysow:ray/step
}

# Found functions run at the corner of the crop block and zero #left, which ends the ray. Torchflower is not harvested, its
# crop grows into the finished flower. Pitcher crop is final at age 4, two blocks tall, and only with the config set to 1.
function step {
    scoreboard players remove #left rwysow 1
    REPEAT (simpleCrops) as crop {
        execute if block ~ ~ ~ minecraft:<%crop.name%>[age=<%crop.age%>] align xyz run function rwysow:found/<%crop.name%>
    }
    REPEAT (stackCrops) as crop {
        execute if block ~ ~ ~ minecraft:<%crop.name%> align xyz run function rwysow:stack/<%crop.name%>/found
        REPEAT (crop.top ? [crop.top] : []) as top {
            execute if block ~ ~ ~ <%top%> align xyz run function rwysow:stack/<%crop.name%>/found
        }
    }
    execute if score #config.enable_pitcher_crop rwysow matches 1 if block ~ ~ ~ minecraft:pitcher_crop[age=4,half=lower] align xyz run function rwysow:found/pitcher_crop
    execute if score #config.enable_pitcher_crop rwysow matches 1 if block ~ ~ ~ minecraft:pitcher_crop[age=4,half=upper] align xyz positioned ~ ~-1 ~ run function rwysow:found/pitcher_crop
    execute if score #left rwysow matches 1.. if block ~ ~ ~ #rwysow:ray/ray_pass positioned ^ ^ ^<%config.rayStep%> run function rwysow:ray/step
}
