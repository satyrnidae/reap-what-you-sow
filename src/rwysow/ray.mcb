function start {
    scoreboard players set #left rwysow 100
    execute anchored eyes positioned ^ ^ ^ run function rwysow:ray/step
}

# One 0.05 block step of the click ray, 100 steps is 5 blocks. The client picks a crop by its outline, not its whole cell, so a
# hit only counts under the mature outline height: the sample point shifted up by 1 minus that height is still in the crop cell
# only while the unshifted point is under the outline. Above the outline the ray carries on to whatever is behind. Wheat and
# the pitcher plant fill the cell. Crops below their outline end the ray whether mature or not, so an immature crop never lets
# the click reach a mature one behind it. Matches align to the block, harvest functions run at its corner.
function step {
    scoreboard players remove #left rwysow 1
    execute if block ~ ~ ~ minecraft:wheat[age=7] align xyz run function rwysow:harvest/wheat
    execute positioned ~ ~0.4375 ~ if block ~ ~ ~ minecraft:carrots[age=7] align xyz run function rwysow:harvest/carrots
    execute positioned ~ ~0.4375 ~ if block ~ ~ ~ minecraft:potatoes[age=7] align xyz run function rwysow:harvest/potatoes
    execute positioned ~ ~0.5 ~ if block ~ ~ ~ minecraft:beetroots[age=3] align xyz run function rwysow:harvest/beetroots
    execute positioned ~ ~0.125 ~ if block ~ ~ ~ minecraft:nether_wart[age=3] align xyz run function rwysow:harvest/nether_wart
    # Ancient farming, off unless the config is 1. Farmland below keeps decorative flowers safe and the reset crop alive.
    execute if score #config.enable_ancient_farming rwysow matches 1 positioned ~ ~0.375 ~ if block ~ ~ ~ minecraft:torchflower if block ~ ~-1 ~ minecraft:farmland align xyz run function rwysow:harvest/torchflower
    execute if score #config.enable_ancient_farming rwysow matches 1 if block ~ ~ ~ minecraft:pitcher_plant[half=lower] if block ~ ~-1 ~ minecraft:farmland align xyz run function rwysow:harvest/pitcher_plant
    execute if score #config.enable_ancient_farming rwysow matches 1 if block ~ ~ ~ minecraft:pitcher_plant[half=upper] if block ~ ~-2 ~ minecraft:farmland align xyz positioned ~ ~-1 ~ run function rwysow:harvest/pitcher_plant
    execute if score #left rwysow matches 1.. if block ~ ~ ~ #rwysow:ray_passable positioned ^ ^ ^0.05 run function rwysow:ray/step
    execute if score #left rwysow matches 1.. if block ~ ~ ~ minecraft:carrots positioned ~ ~0.4375 ~ unless block ~ ~ ~ minecraft:carrots positioned ~ ~-0.4375 ~ positioned ^ ^ ^0.05 run function rwysow:ray/step
    execute if score #left rwysow matches 1.. if block ~ ~ ~ minecraft:potatoes positioned ~ ~0.4375 ~ unless block ~ ~ ~ minecraft:potatoes positioned ~ ~-0.4375 ~ positioned ^ ^ ^0.05 run function rwysow:ray/step
    execute if score #left rwysow matches 1.. if block ~ ~ ~ minecraft:beetroots positioned ~ ~0.5 ~ unless block ~ ~ ~ minecraft:beetroots positioned ~ ~-0.5 ~ positioned ^ ^ ^0.05 run function rwysow:ray/step
    execute if score #left rwysow matches 1.. if block ~ ~ ~ minecraft:nether_wart positioned ~ ~0.125 ~ unless block ~ ~ ~ minecraft:nether_wart positioned ~ ~-0.125 ~ positioned ^ ^ ^0.05 run function rwysow:ray/step
    execute if score #left rwysow matches 1.. if block ~ ~ ~ minecraft:torchflower positioned ~ ~0.375 ~ unless block ~ ~ ~ minecraft:torchflower positioned ~ ~-0.375 ~ positioned ^ ^ ^0.05 run function rwysow:ray/step
}
