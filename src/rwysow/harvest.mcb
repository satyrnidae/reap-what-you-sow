# Every function runs as the player, at the corner of the crop block. Setting #left to 0 first ends the ray.
# Loot is the block's own table mined with the held hoe, so Fortune and Silk Touch apply as when breaking it by hand.

function wheat {
    scoreboard players set #left rwysow 0
    loot spawn ~0.5 ~0.1 ~0.5 mine ~ ~ ~ mainhand
    setblock ~ ~ ~ minecraft:wheat[age=0]
    playsound minecraft:block.crop.break block @a ~0.5 ~0.5 ~0.5
    particle minecraft:block{block_state:"minecraft:wheat"} ~0.5 ~0.3 ~0.5 0.25 0.2 0.25 0 12
}

